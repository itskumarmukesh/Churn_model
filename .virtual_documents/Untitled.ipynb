import re
from pathlib import Path

names = set()
for f in Path("Untitled.ipynb").glob("*.ipynb"):
    for m in re.findall(r'"\s*(?:import|from)\s+([A-Za-z0-9_]+)', f.read_text(encoding = "utf-8")):
        names.add(m)
print(sorted(names))


